# --- Database -------------------------------------------------------------
# Owner connection: runs migrations, seeds, auth lookups and system jobs.
DATABASE_ADMIN_URL="postgresql://postgres:postgres@localhost:5432/deedwood"
# App connection: a NON-owner role, so Postgres row-level security applies.
DATABASE_URL="postgresql://deedwood_app:deedwood_app@localhost:5432/deedwood"
REDIS_URL="redis://localhost:6379"

# --- Auth -----------------------------------------------------------------
AUTH_SECRET="dev-only-secret-change-me-in-production-0123456789"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# --- Adapters (mock = works offline with zero API keys) --------------------
EMAIL_PROVIDER="mock"          # mock | smtp
SMTP_URL="smtp://localhost:1025" # mailpit in docker-compose
EMAIL_FROM="DeedWood <no-reply@deedwood.local>"

# --- Public ----------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="DeedWood"

# --- Land records (parcel maps, owner of record) --------------------------
# auto: free county parcel maps where registered (src/adapters/parcels/counties.ts), else Regrid if a
#       token is set. mock: sample parcels (demo/offline). off: no lookups.
PARCELS_PROVIDER="auto"
# REGRID_TOKEN=""   # optional — nationwide parcel coverage (paid, regrid.com/api)

# --- Property pictures ------------------------------------------------------
# Free aerial photos (U.S. government NAIP imagery) need no setup. New properties get one
# automatically; turn that off with PLACE_PHOTOS="off".
# GOOGLE_MAPS_API_KEY=""   # optional — Google Street View picture of the front of each building

# --- Marketing site & payments --------------------------------------------------
# SITE_URL="https://deedwood.com"          # public marketing address (canonical links, sitemap)
# CONTACT_EMAIL=""                          # shown on About / Privacy when set
# PAYMENTS_ENABLED="1"                      # online rent payments/autopay/fees — "coming soon" until set
# SITES_ROOT_DOMAIN="deedwood.app"          # company websites at <web name>.<this domain>

# --- Backups & alerts -------------------------------------------------------------
# BACKUP_KEY=""            # encrypts nightly backups — keep a copy somewhere safe!
# BACKUP_KEEP="14"         # how many nightly backups to keep
# PLATFORM_ALERT_EMAIL=""  # email for error alerts (at most one an hour)
# SENTRY_DSN=""            # optional: detailed error reports in Sentry (free tier)

# --- Sign-up protection & "Sign in with…" (each turns on when its keys are set) -----
# TURNSTILE_SITE_KEY=""            # Cloudflare Turnstile "I'm human" check
# TURNSTILE_SECRET_KEY=""
# AUTH_GOOGLE_ID=""                # Sign in with Google
# AUTH_GOOGLE_SECRET=""
# AUTH_MICROSOFT_ENTRA_ID_ID=""    # Sign in with Microsoft
# AUTH_MICROSOFT_ENTRA_ID_SECRET=""

# --- DeedWood subscriptions (Stripe Billing — TEST keys until going live is approved) -----
# STRIPE_SECRET_KEY=""                     # sk_test_… — turns on "Choose a plan" in Settings → Billing
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""    # pk_test_…
# STRIPE_WEBHOOK_SECRET=""                 # whsec_… from the webhook for https://<app>/api/webhooks/stripe
# STRIPE_TAX="1"                           # only after Stripe Tax has your head office + KY registration
# BILLING_ENFORCED="1"                     # make unpaid / trial-ended companies read-only (leave off for the beta)
# BILLING_GRACE_DAYS="3"                   # days after a failed payment before read-only
