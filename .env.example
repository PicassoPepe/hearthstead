# --- Database -------------------------------------------------------------
# Owner connection: runs migrations, seeds, auth lookups and system jobs.
DATABASE_ADMIN_URL="postgresql://postgres:postgres@localhost:5432/deedwood"
# App connection: a NON-owner role, so Postgres row-level security applies.
DATABASE_URL="postgresql://deedwood_app:deedwood_app@localhost:5432/deedwood"
REDIS_URL="redis://localhost:6379"

# --- Auth -----------------------------------------------------------------
AUTH_SECRET="dev-only-secret-change-me-in-production-0123456789"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# --- Adapters (mock = works offline with zero API keys) --------------------
EMAIL_PROVIDER="mock"          # mock | smtp
SMTP_URL="smtp://localhost:1025" # mailpit in docker-compose
EMAIL_FROM="DeedWood <no-reply@deedwood.local>"

# --- Public ----------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="DeedWood"
