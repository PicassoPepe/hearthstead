// Hearthstead data model.
// Conventions:
//  * Every tenant-owned row carries `organizationId` and is protected by Postgres RLS
//    (see prisma/rls.sql) *and* by the data-access layer (src/server/dal).
//  * Every model has createdAt / updatedAt / createdById / deletedAt (soft delete).
//  * Money is always integer cents (`Int` / `BigInt`), never floats.
// Phase 1 models live here; later phases append to this file.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_ADMIN_URL")
}

// ─── Tenancy & identity ────────────────────────────────────────────────────

model Organization {
  id           String    @id @default(cuid())
  name         String
  slug         String    @unique
  logoUrl      String?
  brandColor   String    @default("#0F766E")
  timezone     String    @default("America/New_York")
  phone        String?
  email        String?
  addressLine1 String?
  city         String?
  state        String?
  postalCode   String?
  sandbox      Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  createdById  String?
  deletedAt    DateTime?

  memberships Membership[]
  roles       Role[]
  settings    Setting[]
  auditLogs   AuditLog[]
}

model User {
  id               String    @id @default(cuid())
  email            String    @unique
  name             String?
  emailVerified    DateTime?
  image            String?
  passwordHash     String?
  twoFactorEnabled Boolean   @default(false)
  /// Per-user UI preferences (sidebar collapsed, dismissed checklist, dashboard layout...)
  preferences      Json      @default("{}")
  lastOrgId        String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  createdById      String?
  deletedAt        DateTime?

  accounts    AuthAccount[]
  sessions    Session[]
  memberships Membership[]
  tenantLinks TenantUser[]
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

model Membership {
  id             String           @id @default(cuid())
  organizationId String
  userId         String
  roleId         String
  status         MembershipStatus @default(ACTIVE)
  /// Empty = all properties. Otherwise the member is limited to these property ids.
  propertyScope  String[]         @default([])
  invitedAt      DateTime?
  acceptedAt     DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  createdById    String?
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id])

  @@unique([organizationId, userId])
  @@index([userId])
}

model Role {
  id             String    @id @default(cuid())
  organizationId String
  /// Stable key for built-in roles (ADMIN, PROPERTY_MANAGER, ...). Null for custom roles.
  key            String?
  name           String
  description    String?
  isSystem       Boolean   @default(false)
  /// { [module]: "none" | "view" | "edit" | "delete" } — see src/server/permissions
  permissions    Json
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  createdById    String?
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships  Membership[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

// ─── Auth.js tables (global, not tenant-scoped) ───────────────────────────

model AuthAccount {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Settings (inheritance: LEASE → PROPERTY → ORG → default) ─────────────

enum SettingScope {
  ORG
  PROPERTY
  LEASE
}

model Setting {
  id             String       @id @default(cuid())
  organizationId String
  scope          SettingScope
  /// orgId for ORG scope, propertyId for PROPERTY, leaseId for LEASE.
  scopeId        String
  key            String
  value          Json
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  createdById    String?
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, scope, scopeId, key])
  @@index([organizationId, key])
}

// ─── Audit & outbound mail (mock adapter) ─────────────────────────────────

model AuditLog {
  id             String    @id @default(cuid())
  organizationId String
  actorId        String?
  actorType      String    @default("USER") // USER | SYSTEM | AI | API
  action         String
  entityType     String
  entityId       String?
  before         Json?
  after          Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  createdById    String?
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, entityType, entityId])
  @@index([organizationId, createdAt])
}

/// Every email the EmailProvider sends is recorded here (the mock provider only records).
model EmailMessage {
  id             String    @id @default(cuid())
  organizationId String?
  provider       String
  to             String
  subject        String
  html           String
  text           String?
  status         String    @default("SENT")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  createdById    String?
  deletedAt      DateTime?

  @@index([to, createdAt])
}

// ─── Phase 2: Rentals ─────────────────────────────────────────────────────

model Portfolio {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  description    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  createdById    String?
  deletedAt      DateTime?

  properties Property[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

enum PropertyType {
  SINGLE_FAMILY
  MULTI_FAMILY
  CONDO
  TOWNHOME
  COMMERCIAL_OFFICE
  COMMERCIAL_RETAIL
  COMMERCIAL_INDUSTRIAL
  HOA
}

model Property {
  id                        String       @id @default(cuid())
  organizationId            String
  portfolioId               String?
  name                      String
  type                      PropertyType
  addressLine1              String
  addressLine2              String?
  city                      String
  state                     String
  postalCode                String
  country                   String       @default("US")
  yearBuilt                 Int?
  photoUrl                  String?
  /// Default bank accounts used when posting money for this property (chart-of-accounts ids).
  defaultOperatingAccountId String?
  defaultDepositAccountId   String?
  /// Cash held back from owner distributions (integer cents).
  reserveCents              Int          @default(0)
  createdAt                 DateTime     @default(now())
  updatedAt                 DateTime     @updatedAt
  createdById               String?
  deletedAt                 DateTime?

  portfolio        Portfolio?          @relation(fields: [portfolioId], references: [id])
  defaultOperating Account?            @relation("PropertyOperating", fields: [defaultOperatingAccountId], references: [id])
  defaultDeposit   Account?            @relation("PropertyDeposit", fields: [defaultDepositAccountId], references: [id])
  units            Unit[]
  ownerships       PropertyOwnership[]
  leases           Lease[]

  @@index([organizationId, deletedAt])
  @@index([portfolioId])
}

model Unit {
  id              String    @id @default(cuid())
  organizationId  String
  propertyId      String
  name            String
  beds            Int?
  /// Stored in tenths so 1.5 baths is 15 — no floats.
  bathsTenths     Int?
  sqft            Int?
  marketRentCents Int       @default(0)
  amenities       String[]  @default([])
  photos          String[]  @default([])
  isListed        Boolean   @default(false)
  inApplications  Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  createdById     String?
  deletedAt       DateTime?

  property Property    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  leases   LeaseUnit[]

  @@index([organizationId, propertyId])
}

model Owner {
  id             String    @id @default(cuid())
  organizationId String
  /// "PERSON" or "COMPANY"
  kind           String    @default("PERSON")
  firstName      String?
  lastName       String?
  companyName    String?
  email          String?
  phone          String?
  addressLine1   String?
  city           String?
  state          String?
  postalCode     String?
  /// e.g. { taxIdType: "SSN" | "EIN", taxIdLast4: "1234", taxName: "...", send1099: true }
  taxInfo        Json      @default("{}")
  portalStatus   String    @default("NOT_INVITED") // NOT_INVITED | INVITED | ACTIVE
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  createdById    String?
  deletedAt      DateTime?

  ownerships PropertyOwnership[]

  @@index([organizationId, deletedAt])
}

model PropertyOwnership {
  id             String    @id @default(cuid())
  organizationId String
  ownerId        String
  propertyId     String
  /// Ownership share in basis points (10000 = 100%).
  percentBps     Int
  agreementStart DateTime? @db.Date
  agreementEnd   DateTime? @db.Date
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  createdById    String?
  deletedAt      DateTime?

  owner    Owner    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, ownerId])
  @@index([organizationId])
}

// Chart of accounts. Created now so properties can reference their default bank accounts;
// the ledger that posts to these arrives in Phase 3.
enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

model Account {
  id             String      @id @default(cuid())
  organizationId String
  code           String
  name           String
  type           AccountType
  isBank         Boolean     @default(false)
  /// System accounts (A/R, Undeposited Funds, ...) can't be deleted or renamed.
  isSystem       Boolean     @default(false)
  /// Stable key for system accounts, e.g. "ACCOUNTS_RECEIVABLE".
  systemKey      String?
  parentId       String?
  active         Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  createdById    String?
  deletedAt      DateTime?

  bankAccount         BankAccount?
  journalLines        JournalLine[]
  recurringCharges    RecurringCharge[]
  operatingProperties Property[]        @relation("PropertyOperating")
  depositProperties   Property[]        @relation("PropertyDeposit")

  @@unique([organizationId, code])
  @@unique([organizationId, systemKey])
  @@index([organizationId, type])
}

model BankAccount {
  id             String    @id @default(cuid())
  organizationId String
  accountId      String    @unique
  institution    String?
  mask           String? // last 4 digits only
  /// "OPERATING" | "TRUST" | "SECURITY_DEPOSIT"
  purpose        String    @default("OPERATING")
  externalRef    String? // Stripe / Plaid link id
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  createdById    String?
  deletedAt      DateTime?

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

// ─── Polymorphic notes & files ────────────────────────────────────────────

model Note {
  id             String    @id @default(cuid())
  organizationId String
  entityType     String // "Property" | "Unit" | "Owner" | ...
  entityId       String
  body           String
  pinned         Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  createdById    String?
  deletedAt      DateTime?

  @@index([organizationId, entityType, entityId])
}

/// A stored file. (Named Attachment to avoid clashing with the DOM `File` type in TypeScript.)
model Attachment {
  id             String    @id @default(cuid())
  organizationId String
  entityType     String?
  entityId       String?
  name           String
  contentType    String
  sizeBytes      Int
  storageKey     String    @unique
  category       String? // "Lease" | "Photo" | "Statement" | "Other" ...
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  createdById    String?
  deletedAt      DateTime?

  @@index([organizationId, entityType, entityId])
}

// ─── Phase 3: Leasing & ledger ─────────────────────────────────────────────

model Tenant {
  id             String    @id @default(cuid())
  organizationId String
  kind           String    @default("PERSON") // PERSON | COMPANY
  firstName      String?
  lastName       String?
  companyName    String?
  email          String?
  phone          String?
  dateOfBirth    DateTime? @db.Date
  /// NOT_INVITED | INVITED | ACTIVE
  portalStatus   String    @default("NOT_INVITED")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  createdById    String?
  deletedAt      DateTime?

  leases         LeaseTenant[]
  users          TenantUser[]
  paymentMethods PaymentMethod[]

  @@index([organizationId, deletedAt])
}

enum LeaseStatus {
  DRAFT
  ACTIVE
  ENDED
  EVICTION
}

enum TermType {
  FIXED
  MONTH_TO_MONTH
}

model Lease {
  id             String      @id @default(cuid())
  organizationId String
  propertyId     String
  status         LeaseStatus @default(DRAFT)
  termType       TermType    @default(FIXED)
  startDate      DateTime    @db.Date
  endDate        DateTime?   @db.Date
  moveInDate     DateTime?   @db.Date
  moveOutDate    DateTime?   @db.Date
  /// Rent due day of month (1-28).
  rentDueDay     Int         @default(1)
  /// Security deposit the lease requires (what's actually held comes from the ledger).
  depositCents   Int         @default(0)
  endedReason    String?
  noticeGivenAt  DateTime?   @db.Date
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  createdById    String?
  deletedAt      DateTime?

  property     Property           @relation(fields: [propertyId], references: [id])
  units        LeaseUnit[]
  tenants      LeaseTenant[]
  recurring    RecurringCharge[]
  transactions LeaseTransaction[]

  @@index([organizationId, status])
  @@index([propertyId])
}

model LeaseUnit {
  id             String   @id @default(cuid())
  organizationId String
  leaseId        String
  unitId         String
  createdAt      DateTime @default(now())

  lease Lease @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  unit  Unit  @relation(fields: [unitId], references: [id])

  @@unique([leaseId, unitId])
  @@index([unitId])
}

enum LeaseTenantRole {
  PRIMARY
  COTENANT
  COSIGNER
}

model LeaseTenant {
  id             String          @id @default(cuid())
  organizationId String
  leaseId        String
  tenantId       String
  role           LeaseTenantRole @default(PRIMARY)
  createdAt      DateTime        @default(now())

  lease  Lease  @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([leaseId, tenantId])
  @@index([tenantId])
}

enum ChargeKind {
  RENT
  OTHER
}

model RecurringCharge {
  id             String     @id @default(cuid())
  organizationId String
  leaseId        String
  kind           ChargeKind @default(RENT)
  accountId      String
  description    String
  amountCents    Int
  /// MONTHLY only for now (QUARTERLY/ANNUAL later).
  frequency      String     @default("MONTHLY")
  startDate      DateTime   @db.Date
  endDate        DateTime?  @db.Date
  nextRunDate    DateTime   @db.Date
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  createdById    String?
  deletedAt      DateTime?

  lease   Lease                @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  account Account              @relation(fields: [accountId], references: [id])
  runs    RecurringChargeRun[]

  @@index([organizationId, nextRunDate])
}

/// Idempotency for the recurring engine: one row per charge per period ("2026-11").
model RecurringChargeRun {
  id                String   @id @default(cuid())
  organizationId    String
  recurringChargeId String
  period            String
  transactionId     String?
  createdAt         DateTime @default(now())

  recurringCharge RecurringCharge @relation(fields: [recurringChargeId], references: [id], onDelete: Cascade)

  @@unique([recurringChargeId, period])
}

enum LeaseTxType {
  CHARGE
  PAYMENT
  CREDIT
  DEPOSIT
  REFUND
  RETURNED_PAYMENT
}

model LeaseTransaction {
  id              String      @id @default(cuid())
  organizationId  String
  leaseId         String
  type            LeaseTxType
  /// Always positive; the type gives the direction.
  amountCents     Int
  date            DateTime    @db.Date
  /// For charges: when it's due (defaults to date).
  dueDate         DateTime?   @db.Date
  memo            String?
  accountId       String?
  /// RENT charges are what late fees are assessed on.
  chargeKind      String? // RENT | LATE_FEE | NSF_FEE | OTHER | OPENING_BALANCE
  /// For payments: CASH | CHECK | ACH | CARD | OTHER; reference = check #.
  method          String?
  reference       String?
  journalEntryId  String      @unique
  paymentIntentId String?
  /// RETURNED_PAYMENT → the payment it reverses.
  relatedId       String?
  /// Bank deposit this payment was banked in (Phase 6).
  depositId       String?
  voidedAt        DateTime?
  voidReason      String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  createdById     String?
  deletedAt       DateTime?

  lease        Lease                @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  journalEntry JournalEntry         @relation(fields: [journalEntryId], references: [id])
  appliedFrom  PaymentApplication[] @relation("ApplicationSource")
  appliedTo    PaymentApplication[] @relation("ApplicationCharge")

  @@index([organizationId, leaseId, date])
  @@index([organizationId, type, date])
}

/// Which charges a payment/credit (or prepaid balance) paid off — drives aging and late fees.
model PaymentApplication {
  id             String   @id @default(cuid())
  organizationId String
  sourceId       String
  chargeId       String
  amountCents    Int
  createdAt      DateTime @default(now())

  source LeaseTransaction @relation("ApplicationSource", fields: [sourceId], references: [id], onDelete: Cascade)
  charge LeaseTransaction @relation("ApplicationCharge", fields: [chargeId], references: [id], onDelete: Cascade)

  @@index([organizationId, chargeId])
  @@index([sourceId])
}

/// Idempotency for late fees: one assessment per lease per key ("2026-11:initial" or "2026-11-08:daily").
model LateFeeRun {
  id             String   @id @default(cuid())
  organizationId String
  leaseId        String
  key            String
  transactionId  String?
  createdAt      DateTime @default(now())

  @@unique([leaseId, key])
}

model JournalEntry {
  id             String    @id @default(cuid())
  organizationId String
  date           DateTime  @db.Date
  memo           String?
  /// LEASE_CHARGE | LEASE_PAYMENT | ... | MANUAL | OPENING_BALANCE
  source         String
  sourceId       String?
  /// Set on an entry that reverses another (voids).
  reversesId     String?   @unique
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  createdById    String?
  deletedAt      DateTime?

  lines            JournalLine[]
  leaseTransaction LeaseTransaction?
  reverses         JournalEntry?     @relation("Reversal", fields: [reversesId], references: [id])
  reversedBy       JournalEntry?     @relation("Reversal")

  @@index([organizationId, date])
  @@index([organizationId, source])
}

model JournalLine {
  id               String   @id @default(cuid())
  organizationId   String
  journalEntryId   String
  accountId        String
  debitCents       Int      @default(0)
  creditCents      Int      @default(0)
  propertyId       String?
  unitId           String?
  leaseId          String?
  memo             String?
  /// Set when this line was ticked off in a completed bank reconciliation.
  reconciliationId String?
  createdAt        DateTime @default(now())

  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account      Account      @relation(fields: [accountId], references: [id])

  @@index([organizationId, accountId])
  @@index([organizationId, leaseId])
  @@index([organizationId, propertyId])
}

// ─── Phase 4: Payments & tenant portal ─────────────────────────────────────

/**
 * Links a login (User) to a Tenant record for the tenant portal.
 */
model TenantUser {
  id             String    @id @default(cuid())
  organizationId String
  tenantId       String
  userId         String
  invitedAt      DateTime  @default(now())
  acceptedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  createdById    String?
  deletedAt      DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([userId])
}

/**
 * The organization's account with the payments processor (Stripe Connect Express / mock).
 */
model ProcessorAccount {
  id             String    @id @default(cuid())
  organizationId String    @unique
  provider       String // mock | stripe
  externalId     String
  /// PENDING | ACTIVE | RESTRICTED
  status         String    @default("PENDING")
  chargesEnabled Boolean   @default(false)
  payoutsEnabled Boolean   @default(false)
  payoutBankMask String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  createdById    String?
  deletedAt      DateTime?
}

model PaymentMethod {
  id             String    @id @default(cuid())
  organizationId String
  tenantId       String
  /// CARD | ACH
  type           String
  brand          String?
  bankName       String?
  last4          String
  expMonth       Int?
  expYear        Int?
  /// ACH accounts must be verified (Financial Connections / mock) before use.
  verified       Boolean   @default(false)
  isDefault      Boolean   @default(false)
  providerRef    String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  createdById    String?
  deletedAt      DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([organizationId, tenantId])
}

enum PaymentStatus {
  INITIATED
  PROCESSING
  SUCCEEDED
  FAILED
  PAID_OUT
  CANCELED
}

model PaymentIntent {
  id                 String        @id @default(cuid())
  organizationId     String
  leaseId            String
  tenantId           String?
  paymentMethodId    String?
  /// CARD | ACH
  methodType         String
  /// Applied to the tenant's balance.
  amountCents        Int
  /// Convenience fee charged on top (pass-through), never posted to the tenant ledger.
  feeCents           Int           @default(0)
  status             PaymentStatus @default(INITIATED)
  provider           String
  providerRef        String        @unique
  leaseTransactionId String?       @unique
  failureReason      String?
  /// AUTOPAY | PORTAL | STAFF
  origin             String        @default("PORTAL")
  expectedPayoutDate DateTime?     @db.Date
  /// Business date the payment was made (org timezone) — drives settlement timing.
  initiatedOn        DateTime      @default(now()) @db.Date
  idempotencyKey     String?       @unique
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  createdById        String?
  deletedAt          DateTime?

  events PaymentEvent[]

  @@index([organizationId, status])
  @@index([organizationId, leaseId])
}

model PaymentEvent {
  id              String        @id @default(cuid())
  organizationId  String
  paymentIntentId String
  status          PaymentStatus
  note            String?
  createdAt       DateTime      @default(now())

  paymentIntent PaymentIntent @relation(fields: [paymentIntentId], references: [id], onDelete: Cascade)

  @@index([paymentIntentId])
}

model Autopay {
  id              String    @id @default(cuid())
  organizationId  String
  leaseId         String
  tenantId        String
  paymentMethodId String
  /// Day of the month the payment runs (1-28).
  dayOfMonth      Int
  /// FULL_BALANCE | FIXED
  amountMode      String    @default("FULL_BALANCE")
  fixedCents      Int?
  active          Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  createdById     String?
  deletedAt       DateTime?

  @@unique([leaseId, tenantId])
}

/// Idempotency for autopay: one run per autopay per period.
model AutopayRun {
  id              String   @id @default(cuid())
  organizationId  String
  autopayId       String
  period          String
  paymentIntentId String?
  note            String?
  createdAt       DateTime @default(now())

  @@unique([autopayId, period])
}

model InsurancePolicy {
  id             String    @id @default(cuid())
  organizationId String
  leaseId        String
  tenantId       String?
  carrier        String
  policyNumber   String
  liabilityCents Int?
  effectiveDate  DateTime  @db.Date
  expiresOn      DateTime  @db.Date
  /// UPLOADED | PARTNER
  source         String    @default("UPLOADED")
  attachmentId   String?
  /// PENDING_REVIEW | VERIFIED | EXPIRED
  status         String    @default("PENDING_REVIEW")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  createdById    String?
  deletedAt      DateTime?

  @@index([organizationId, leaseId])
}

// ─── Phase 5: Maintenance ─────────────────────────────────────────────────

model Vendor {
  id                      String    @id @default(cuid())
  organizationId          String
  name                    String
  contactName             String?
  email                   String?
  phone                   String?
  /// Trades: PLUMBING, ELECTRICAL, HVAC, APPLIANCE, GENERAL, LANDSCAPING, CLEANING, PEST, ROOFING, LOCKSMITH
  trades                  String[]  @default([])
  addressLine1            String?
  city                    String?
  state                   String?
  postalCode              String?
  /// Only the last 4 digits are stored.
  taxIdLast4              String?
  send1099                Boolean   @default(true)
  w9OnFile                Boolean   @default(false)
  insuranceExpires        DateTime? @db.Date
  /// Login (Vendor role) that may see this vendor's work orders.
  userId                  String?
  defaultExpenseAccountId String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  createdById             String?
  deletedAt               DateTime?

  tasks Task[]
  bills Bill[]

  @@index([organizationId, deletedAt])
  @@index([userId])
}

enum TaskType {
  TASK
  TENANT_REQUEST
  OWNER_REQUEST
  WORK_ORDER
  INSPECTION
}

enum TaskStatus {
  NOT_STARTED
  IN_PROGRESS
  WAITING
  COMPLETED
  ARCHIVED
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model Task {
  id                String       @id @default(cuid())
  organizationId    String
  /// Human-friendly number per org (#1042).
  number            Int
  type              TaskType     @default(TASK)
  status            TaskStatus   @default(NOT_STARTED)
  priority          TaskPriority @default(NORMAL)
  title             String
  description       String?
  category          String?
  dueDate           DateTime?    @db.Date
  propertyId        String?
  unitId            String?
  leaseId           String?
  tenantId          String?
  ownerId           String?
  /// Generic link to any record (polymorphic), in addition to the typed links above.
  linkedEntityType  String?
  linkedEntityId    String?
  vendorId          String?
  parentTaskId      String?
  permissionToEnter Boolean?
  preferredTimes    String?
  estimateCents     Int?
  /// STAFF | PORTAL | WORKFLOW | AI
  source            String       @default("STAFF")
  /// MOVE_IN | MOVE_OUT | PERIODIC (inspections)
  inspectionKind    String?
  aiSummary         String?
  billId            String?
  completedAt       DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  createdById       String?
  deletedAt         DateTime?

  vendor     Vendor?          @relation(fields: [vendorId], references: [id])
  parent     Task?            @relation("Subtasks", fields: [parentTaskId], references: [id])
  subtasks   Task[]           @relation("Subtasks")
  assignees  TaskAssignee[]
  activities TaskActivity[]
  items      InspectionItem[]

  @@unique([organizationId, number])
  @@index([organizationId, status])
  @@index([organizationId, type])
  @@index([propertyId])
  @@index([vendorId])
}

model TaskAssignee {
  id             String   @id @default(cuid())
  organizationId String
  taskId         String
  userId         String
  createdAt      DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@index([userId])
}

model TaskActivity {
  id             String   @id @default(cuid())
  organizationId String
  taskId         String
  /// COMMENT | STATUS | ASSIGNED | VENDOR | CREATED | BILL | PHOTO
  kind           String
  body           String
  /// Visible to the tenant in the portal timeline.
  public         Boolean  @default(false)
  actorId        String?
  actorName      String?
  createdAt      DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
}

model InspectionItem {
  id             String   @id @default(cuid())
  organizationId String
  taskId         String
  room           String
  item           String
  /// GOOD | FAIR | POOR | DAMAGED | NA
  condition      String?
  note           String?
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

enum BillStatus {
  DRAFT
  OPEN
  PARTIALLY_PAID
  PAID
  VOID
}

/// Accounts payable. Created from vendor invoices (Phase 5); paying bills comes in Phase 6.
model Bill {
  id             String     @id @default(cuid())
  organizationId String
  vendorId       String
  billNumber     String?
  billDate       DateTime   @db.Date
  dueDate        DateTime   @db.Date
  memo           String?
  status         BillStatus @default(OPEN)
  totalCents     Int
  journalEntryId String?    @unique
  taskId         String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  createdById    String?
  deletedAt      DateTime?

  vendor Vendor     @relation(fields: [vendorId], references: [id])
  lines  BillLine[]

  @@index([organizationId, status])
  @@index([vendorId])
}

model BillLine {
  id             String  @id @default(cuid())
  organizationId String
  billId         String
  accountId      String
  amountCents    Int
  description    String?
  propertyId     String?
  unitId         String?

  bill Bill @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@index([billId])
}

// ─── Phase 6: Accounting ──────────────────────────────────────────────────

model BillPayment {
  id             String    @id @default(cuid())
  organizationId String
  billId         String
  amountCents    Int
  date           DateTime  @db.Date
  /// Bank (chart-of-accounts id) the money left from.
  bankAccountId  String
  method         String    @default("CHECK")
  reference      String?
  journalEntryId String    @unique
  voidedAt       DateTime?
  createdAt      DateTime  @default(now())
  createdById    String?

  @@index([organizationId, billId])
}

model RecurringBill {
  id             String    @id @default(cuid())
  organizationId String
  vendorId       String
  memo           String?
  /// [{ accountId, amountCents, propertyId?, unitId?, description? }]
  lines          Json
  dayOfMonth     Int
  dueDays        Int       @default(15)
  nextRunDate    DateTime  @db.Date
  endDate        DateTime? @db.Date
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  createdById    String?
  deletedAt      DateTime?

  @@index([organizationId, nextRunDate])
}

model RecurringBillRun {
  id              String   @id @default(cuid())
  organizationId  String
  recurringBillId String
  period          String
  billId          String?
  createdAt       DateTime @default(now())

  @@unique([recurringBillId, period])
}

model Expense {
  id             String    @id @default(cuid())
  organizationId String
  vendorId       String?
  payee          String
  date           DateTime  @db.Date
  bankAccountId  String
  method         String    @default("DEBIT_CARD")
  reference      String?
  memo           String?
  totalCents     Int
  journalEntryId String    @unique
  voidedAt       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  createdById    String?
  deletedAt      DateTime?

  lines ExpenseLine[]

  @@index([organizationId, date])
}

model ExpenseLine {
  id             String  @id @default(cuid())
  organizationId String
  expenseId      String
  accountId      String
  amountCents    Int
  description    String?
  propertyId     String?
  unitId         String?

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
}

model VendorCredit {
  id              String   @id @default(cuid())
  organizationId  String
  vendorId        String
  date            DateTime @db.Date
  amountCents     Int
  accountId       String
  propertyId      String?
  memo            String?
  appliedToBillId String?
  journalEntryId  String   @unique
  createdAt       DateTime @default(now())
  createdById     String?

  @@index([organizationId, vendorId])
}

/// Bank deposit: moves selected payments from Undeposited Funds to a bank account.
model Deposit {
  id             String   @id @default(cuid())
  organizationId String
  bankAccountId  String
  date           DateTime @db.Date
  totalCents     Int
  memo           String?
  journalEntryId String   @unique
  createdAt      DateTime @default(now())
  createdById    String?

  items DepositItem[]
}

model DepositItem {
  id                 String @id @default(cuid())
  organizationId     String
  depositId          String
  leaseTransactionId String @unique
  amountCents        Int

  deposit Deposit @relation(fields: [depositId], references: [id], onDelete: Cascade)
}

/// Imported bank-feed / CSV line.
model BankTransaction {
  id             String   @id @default(cuid())
  organizationId String
  /// Chart-of-accounts id of the bank account.
  bankAccountId  String
  date           DateTime @db.Date
  /// + money in, − money out.
  amountCents    Int
  description    String
  externalId     String
  /// UNMATCHED | MATCHED | CATEGORIZED | IGNORED
  status         String   @default("UNMATCHED")
  matchedLineId  String?
  journalEntryId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([bankAccountId, externalId])
  @@index([organizationId, bankAccountId, status])
}

model Reconciliation {
  id                    String    @id @default(cuid())
  organizationId        String
  bankAccountId         String
  statementDate         DateTime  @db.Date
  statementBalanceCents Int
  openingBalanceCents   Int
  /// IN_PROGRESS | COMPLETED
  status                String    @default("IN_PROGRESS")
  completedAt           DateTime?
  createdAt             DateTime  @default(now())
  createdById           String?

  @@index([organizationId, bankAccountId])
}

model OwnerDistribution {
  id             String   @id @default(cuid())
  organizationId String
  ownerId        String
  propertyId     String
  /// DISTRIBUTION | CONTRIBUTION
  kind           String   @default("DISTRIBUTION")
  amountCents    Int
  date           DateTime @db.Date
  bankAccountId  String
  method         String   @default("ACH")
  memo           String?
  journalEntryId String   @unique
  createdAt      DateTime @default(now())
  createdById    String?

  @@index([organizationId, ownerId])
  @@index([organizationId, propertyId])
}

model ManagementFeeRule {
  id             String    @id @default(cuid())
  organizationId String
  /// null = company default
  propertyId     String?
  /// PERCENT | FLAT
  type           String    @default("PERCENT")
  percentBps     Int       @default(800)
  flatCents      Int       @default(0)
  minimumCents   Int       @default(0)
  /// COLLECTED_RENT | COLLECTED_INCOME
  basis          String    @default("COLLECTED_RENT")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  createdById    String?
  deletedAt      DateTime?

  @@unique([organizationId, propertyId])
}

model ManagementFeeRun {
  id             String   @id @default(cuid())
  organizationId String
  propertyId     String
  period         String
  feeCents       Int
  basisCents     Int
  billId         String?
  createdAt      DateTime @default(now())

  @@unique([propertyId, period])
}

// ───────────────────────────── Phase 8: owner portal & communications ─────────────────────────────

/// Links a login to an Owner record (owner portal). Users are global; the link is tenant data.
model OwnerUser {
  id             String    @id @default(cuid())
  organizationId String
  ownerId        String
  userId         String
  invitedAt      DateTime  @default(now())
  acceptedAt     DateTime?
  createdAt      DateTime  @default(now())
  createdById    String?
  deletedAt      DateTime?

  @@unique([ownerId, userId])
  @@index([userId])
  @@index([organizationId])
}

/// One thread with a tenant, owner, vendor or an unknown phone number (inbound SMS).
model Conversation {
  id                 String    @id @default(cuid())
  organizationId     String
  subject            String?
  tenantId           String?
  ownerId            String?
  vendorId           String?
  /// Normalized +1XXXXXXXXXX for SMS threads.
  phone              String?
  /// OPEN | CLOSED
  status             String    @default("OPEN")
  assigneeId         String?
  lastMessageAt      DateTime  @default(now())
  lastMessagePreview String?
  /// Inbound messages staff haven't read.
  unreadCount        Int       @default(0)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  messages Message[]

  @@index([organizationId, lastMessageAt])
  @@index([organizationId, tenantId])
  @@index([organizationId, ownerId])
  @@index([organizationId, phone])
}

model Message {
  id             String    @id @default(cuid())
  organizationId String
  conversationId String
  /// IN (from the contact) | OUT (from staff/system)
  direction      String
  /// PORTAL | SMS | EMAIL | NOTE (internal)
  channel        String
  body           String
  authorUserId   String?
  authorName     String
  /// QUEUED | SENT | DELIVERED | FAILED | RECEIVED
  status         String    @default("SENT")
  externalId     String?
  /// SMS segments billed (metering).
  segments       Int       @default(0)
  error          String?
  /// When the contact read it (portal) — staff read state lives on the conversation.
  readAt         DateTime?
  announcementId String?
  aiDrafted      Boolean   @default(false)
  createdAt      DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([organizationId, conversationId, createdAt])
  @@index([organizationId, channel, createdAt])
  @@index([externalId])
}

model Announcement {
  id             String    @id @default(cuid())
  organizationId String
  title          String
  body           String
  /// { type: ALL_TENANTS | PROPERTY_TENANTS | ALL_OWNERS | PROPERTY_OWNERS, propertyIds: string[] }
  audience       Json
  /// PORTAL | EMAIL | SMS
  channels       String[]
  /// DRAFT | SCHEDULED | SENT | CANCELED
  status         String    @default("DRAFT")
  scheduledFor   DateTime?
  sentAt         DateTime?
  recipientCount Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  createdById    String?
  deletedAt      DateTime?

  deliveries AnnouncementDelivery[]

  @@index([organizationId, status, scheduledFor])
}

model AnnouncementDelivery {
  id             String   @id @default(cuid())
  organizationId String
  announcementId String
  /// "T:<tenantId>" | "O:<ownerId>"
  recipientKey   String
  tenantId       String?
  ownerId        String?
  channel        String
  /// SENT | FAILED | SKIPPED
  status         String
  error          String?
  createdAt      DateTime @default(now())

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@unique([announcementId, recipientKey, channel])
  @@index([organizationId, tenantId])
  @@index([organizationId, ownerId])
}

/// Numbers that replied STOP. Outbound SMS to them is refused until they reply START.
model SmsOptOut {
  id             String   @id @default(cuid())
  organizationId String
  phone          String
  createdAt      DateTime @default(now())

  @@unique([organizationId, phone])
}

// ───────────────────────────── Phase 9: leasing funnel ─────────────────────────────

model Listing {
  id             String    @id @default(cuid())
  organizationId String
  unitId         String
  propertyId     String
  slug           String
  title          String
  description    String    @default("")
  rentCents      Int
  depositCents   Int       @default(0)
  availableOn    DateTime? @db.Date
  leaseTermMonths Int      @default(12)
  petPolicy      String    @default("Ask about pets")
  /// DRAFT | PUBLISHED | UNLISTED
  status         String    @default("DRAFT")
  syndicate      Boolean   @default(true)
  publishedAt    DateTime?
  unlistedReason String?
  aiDescription  Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  createdById    String?
  deletedAt      DateTime?

  @@unique([organizationId, slug])
  @@index([organizationId, status])
  @@index([unitId])
}

model Prospect {
  id             String    @id @default(cuid())
  organizationId String
  firstName      String
  lastName       String
  email          String?
  phone          String?
  /// WEBSITE | ZILLOW | WALK_IN | REFERRAL | PHONE | OTHER
  source         String    @default("WEBSITE")
  /// NEW | CONTACTED | TOURED | APPLIED | LEASED | LOST
  status         String    @default("NEW")
  listingId      String?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  createdById    String?
  deletedAt      DateTime?

  @@index([organizationId, status])
}

model Showing {
  id             String   @id @default(cuid())
  organizationId String
  listingId      String
  prospectId     String
  startsAt       DateTime
  durationMin    Int      @default(30)
  /// SCHEDULED | COMPLETED | NO_SHOW | CANCELED
  status         String   @default("SCHEDULED")
  agentUserId    String?
  /// STAFF | SELF_SCHEDULED
  source         String   @default("STAFF")
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  createdById    String?

  @@index([organizationId, startsAt])
}

model Application {
  id                String    @id @default(cuid())
  organizationId    String
  number            Int
  listingId         String?
  propertyId        String
  unitId            String?
  /// DRAFT | SUBMITTED | SCREENING | APPROVED | DECLINED | WITHDRAWN
  status            String    @default("DRAFT")
  email             String
  firstName         String    @default("")
  lastName          String    @default("")
  phone             String?
  desiredMoveIn     DateTime? @db.Date
  /// All step data: residence, employment, income, references, pets, vehicles, co-applicants.
  data              Json      @default("{}")
  step              Int       @default(0)
  feeCents          Int       @default(0)
  feePaidAt         DateTime?
  feeReference      String?
  feeJournalEntryId String?
  consentAt         DateTime?
  consentIp         String?
  /// ScreeningProvider result: { provider, reportId, creditScore, criminal, eviction, incomeRatio, recommendation }
  screening         Json?
  screenedAt        DateTime?
  decisionReason    String?
  decidedAt         DateTime?
  decidedById       String?
  leaseId           String?
  prospectId        String?
  /// Hash of the applicant's resume token (the raw token lives only in their cookie/link).
  tokenHash         String    @unique
  submittedAt       DateTime?
  lastSavedAt       DateTime  @default(now())
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  @@unique([organizationId, number])
  @@index([organizationId, status])
}

model DocumentTemplate {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  /// LEASE | RENEWAL | NOTICE | ADVERSE_ACTION | OTHER
  kind           String    @default("OTHER")
  /// Markdown-ish text with {{merge.fields}}
  body           String
  isDefault      Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  createdById    String?
  deletedAt      DateTime?

  @@index([organizationId, kind])
}

model SignatureRequest {
  id                 String    @id @default(cuid())
  organizationId     String
  title              String
  /// Rendered document (HTML) everyone signs — frozen at send time; its SHA-256 is recorded.
  documentHtml       String
  documentHash       String
  leaseId            String?
  renewalOfferId     String?
  templateId         String?
  /// SENT | COMPLETED | VOIDED | DECLINED
  status             String    @default("SENT")
  completedAt        DateTime?
  finalAttachmentId  String?
  createdAt          DateTime  @default(now())
  createdById        String?

  signers Signer[]
  events  SignatureEvent[]

  @@index([organizationId, leaseId])
}

model Signer {
  id             String    @id @default(cuid())
  organizationId String
  requestId      String
  name           String
  email          String
  /// TENANT | COSIGNER | MANAGER
  role           String
  order          Int       @default(1)
  tokenHash      String    @unique
  /// PENDING | VIEWED | SIGNED | DECLINED
  status         String    @default("PENDING")
  signedName     String?
  signedAt       DateTime?
  ip             String?
  userAgent      String?

  request SignatureRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
}

model SignatureEvent {
  id             String   @id @default(cuid())
  organizationId String
  requestId      String
  signerId       String?
  /// SENT | VIEWED | SIGNED | DECLINED | COMPLETED | VOIDED | REMINDED
  event          String
  ip             String?
  userAgent      String?
  createdAt      DateTime @default(now())

  request SignatureRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
}

model RenewalOffer {
  id                 String    @id @default(cuid())
  organizationId     String
  leaseId            String
  newRentCents       Int
  termMonths         Int
  startDate          DateTime  @db.Date
  endDate            DateTime  @db.Date
  /// DRAFT | SENT | ACCEPTED | DECLINED | EXPIRED | WITHDRAWN
  status             String    @default("DRAFT")
  expiresOn          DateTime? @db.Date
  message            String?
  sentAt             DateTime?
  respondedAt        DateTime?
  signatureRequestId String?
  newLeaseId         String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  createdById        String?

  @@index([organizationId, status])
  @@index([leaseId])
}
